# News Event Detection and Tracking System Configuration
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=sqlite:///./news_events.db

# Live News API Providers (Optional - system works offline with local datasets & RSS)
NEWSAPI_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2

# Embedding Model Configuration
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./data/cache/embeddings

# Default Hybrid Weights (alpha + beta + gamma = 1.0)
DEFAULT_ALPHA_SEMANTIC=0.55
DEFAULT_BETA_TEMPORAL=0.25
DEFAULT_GAMMA_ENTITY=0.20

# Clustering Defaults
DEFAULT_SIMILARITY_THRESHOLD=0.62
DEFAULT_TEMPORAL_DECAY_HOURS=72.0
